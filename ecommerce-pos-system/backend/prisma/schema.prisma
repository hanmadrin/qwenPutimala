generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================
// ENUMS
// ===========================

enum UserRole {
  superadmin
  branch_manager
  cashier
  order_manager
}

enum UserStatus {
  active
  inactive
}

enum BranchStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
  draft
}

enum OrderType {
  online
  walk_in
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  complete
  cancelled
  returned
}

enum PaymentStatus {
  unpaid
  paid
  partial
  refunded
}

enum PaymentMethod {
  cod
  sslcommerz
  cash
}

enum PaymentTransactionStatus {
  pending
  success
  failed
  cancelled
  refunded
}

enum CouponType {
  percentage
  fixed
}

enum CouponStatus {
  active
  inactive
}

enum AdjustmentReason {
  purchase
  correction
  return
  damage
  other
}

// ===========================
// MODELS
// ===========================

model Branch {
  id        Int          @id @autoincrement
  name      String
  code      String       @unique
  address   String?
  phone     String?
  is_main   Boolean      @default(false)
  status    BranchStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users           User[]
  orders          Order[]
  branchStock     BranchStock[]
  stockAdjustments StockAdjustment[]
  invoices        Invoice[]

  @@map("branches")
}

model User {
  id        Int        @id @autoincrement
  name      String
  email     String     @unique
  phone     String?
  password  String
  role      UserRole
  branchId  Int?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  branch           Branch?           @relation(fields: [branchId], references: [id])
  orderStatusHistory OrderStatusHistory[]
  stockAdjustments StockAdjustment[]
  backups          Backup[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model Customer {
  id           Int                @id @autoincrement
  name         String
  phone        String             @unique
  email        String?
  passwordHash String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  orders         Order[]
  customerAddresses CustomerAddress[]

  @@map("customers")
}

model CustomerAddress {
  id            Int      @id @autoincrement
  customerId    Int
  label         String
  addressLine1  String
  addressLine2  String?
  area          String
  city          String
  postcode      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@map("customer_addresses")
}

model Category {
  id          Int          @id @autoincrement
  nameEn      String
  nameBn      String
  slug        String       @unique
  parentId    Int?
  image       String?
  status      ProductStatus @default(active)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Brand {
  id        Int          @id @autoincrement
  name      String
  slug      String       @unique
  image     String?
  status    ProductStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Tag {
  id        Int      @id @autoincrement
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("tags")
}

model Product {
  id               Int            @id @autoincrement
  nameEn           String
  nameBn           String
  slug             String         @unique
  shortDescriptionEn String?
  shortDescriptionBn String?
  descriptionEn    String?
  descriptionBn    String?
  price            Decimal(10, 2)
  discountPrice    Decimal(10, 2)?
  categoryId       Int
  brandId          Int?
  sku              String?
  barcode          String?
  weightKg         Decimal(5, 2)?
  dimensionsCm     String?
  status           ProductStatus  @default(active)
  featured         Boolean        @default(false)
  isNewArrival     Boolean        @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  category       Category           @relation(fields: [categoryId], references: [id])
  brand          Brand?             @relation(fields: [brandId], references: [id])
  tags           Tag[]              @relation("ProductToTag")
  productImages  ProductImage[]
  productVariants ProductVariant[]
  orderItems     OrderItem[]

  @@map("products")
}

model ProductImage {
  id         Int      @id @autoincrement
  productId  Int
  imageUrl   String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model ProductVariant {
  id           Int       @id @autoincrement
  productId    Int
  sku          String    @unique
  barcode      String?
  attributes   Json      // {"Size": "M", "Color": "Red"}
  priceOverride Decimal(10, 2)?
  image        String?
  sortOrder    Int       @default(0)
  status       ProductStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product     Product       @relation(fields: [productId], references: [id])
  branchStock BranchStock[]
  orderItems  OrderItem[]

  @@map("product_variants")
}

model BranchStock {
  id                Int      @id @autoincrement
  branchId          Int
  variantId         Int
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt @map("updated_at")

  branch  Branch          @relation(fields: [branchId], references: [id])
  variant ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([branchId, variantId])
  @@map("branch_stock")
}

model Order {
  id                 Int          @id @autoincrement
  orderNumber        String       @unique
  customerId         Int?
  branchId           Int
  orderType          OrderType
  status             OrderStatus  @default(pending)
  paymentStatus      PaymentStatus @default(unpaid)
  paymentMethod      PaymentMethod
  subtotal           Decimal(10, 2)
  discountAmount     Decimal(10, 2) @default(0)
  shippingCharge     Decimal(10, 2) @default(0)
  total              Decimal(10, 2)
  couponId           Int?
  customerNote       String?
  shippingAddressId  Int?
  shippingName       String
  shippingPhone      String
  shippingAddressLine1 String
  shippingArea       String
  shippingCity       String
  shippingPostcode   String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  customer           Customer?            @relation(fields: [customerId], references: [id])
  branch             Branch               @relation(fields: [branchId], references: [id])
  coupon             Coupon?              @relation(fields: [couponId], references: [id])
  customerAddress    CustomerAddress?     @relation(fields: [shippingAddressId], references: [id])
  orderItems         OrderItem[]
  orderStatusHistory OrderStatusHistory[]
  payments           Payment[]
  shipments          Shipment[]
  invoice            Invoice?

  @@map("orders")
}

model OrderItem {
  id          Int      @id @autoincrement
  orderId     Int
  variantId   Int
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal(10, 2)
  totalPrice  Decimal(10, 2)
  attributes  Json
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @autoincrement
  orderId   Int
  oldStatus OrderStatus?
  newStatus OrderStatus
  changedBy Int
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model Payment {
  id            Int                   @id @autoincrement
  orderId       Int
  method        PaymentMethod
  transactionId String?
  amount        Decimal(10, 2)
  status        PaymentTransactionStatus @default(pending)
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Shipment {
  id             Int      @id @autoincrement
  orderId        Int
  courierName    String
  trackingId     String?
  status         String?
  cost           Decimal(10, 2)?
  labelUrl       String?
  pickupAddress  String
  deliveryAddress String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

model Coupon {
  id            Int         @id @autoincrement
  code          String      @unique
  type          CouponType
  value         Decimal(10, 2)
  minOrderAmount Decimal(10, 2)?
  maxDiscount   Decimal(10, 2)?
  validFrom     DateTime
  validUntil    DateTime
  usageLimit    Int?
  usedCount     Int         @default(0)
  status        CouponStatus @default(active)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  orders Order[]

  @@map("coupons")
}

model Invoice {
  id           Int      @id @autoincrement
  orderId      Int      @unique
  invoiceNumber String  @unique
  pdfUrl       String?
  createdAt    DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  branchId Int

  @@map("invoices")
}

model StockAdjustment {
  id           Int              @id @autoincrement
  branchId     Int
  variantId    Int
  previousQty  Int
  newQty       Int
  reason       AdjustmentReason
  note         String?
  adjustedBy   Int
  createdAt    DateTime         @default(now()) @map("created_at")

  branch  Branch         @relation(fields: [branchId], references: [id])
  user    User           @relation(fields: [adjustedBy], references: [id])

  @@map("stock_adjustments")
}

model ActivityLog {
  id         Int      @id @autoincrement
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model Backup {
  id           Int      @id @autoincrement
  filename     String
  driveFileId  String
  sizeMb       Decimal(10, 2)?
  createdBy    Int
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [createdBy], references: [id])

  @@map("backups")
}

// Many-to-Many Relations
model ProductToTag {
  productId Int @map("product_id")
  tagId     Int @map("tag_id")

  product Product @relation(fields: [productId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("_ProductToTag")
}
